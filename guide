STEP 1 — CREATE THIS NEW FILE
------------------------------
Path: app/Services/MLService.php

<?php

namespace App\Services;

use GuzzleHttp\Client;
use GuzzleHttp\Exception\RequestException;

class MLService
{
    protected Client $client;
    protected string $baseUrl;

    public function __construct()
    {
        $this->baseUrl = env('ML_SERVICE_URL', 'http://auratrace-ml:8000');
        $this->client = new Client([
            'base_uri' => $this->baseUrl,
            'timeout'  => 10,
        ]);
    }

    public function getMatchScore(array $foundItem, array $lostReport): ?array
    {
        try {
            $response = $this->client->post('/match', [
                'json' => [
                    'found_item'  => $foundItem,
                    'lost_report' => $lostReport,
                ],
            ]);
            return json_decode($response->getBody()->getContents(), true);
        } catch (RequestException $e) {
            return null;
        }
    }

    public function predictStorage(int $currentCount, int $capacity, float $avgItemsPerDay): ?array
    {
        try {
            $response = $this->client->post('/predict-storage', [
                'json' => [
                    'current_count'     => $currentCount,
                    'capacity'          => $capacity,
                    'avg_items_per_day' => $avgItemsPerDay,
                ],
            ]);
            return json_decode($response->getBody()->getContents(), true);
        } catch (RequestException $e) {
            return null;
        }
    }

    public function identifyImage(string $imagePath): ?array
    {
        try {
            $imageContent = \Storage::get(
                str_replace('/storage/', '', parse_url($imagePath, PHP_URL_PATH))
            );

            if (!$imageContent) return null;

            $response = $this->client->post('/identify', [
                'multipart' => [
                    [
                        'name'     => 'image',
                        'contents' => $imageContent,
                        'filename' => 'item.jpg',
                    ],
                ],
            ]);

            return json_decode($response->getBody()->getContents(), true);

        } catch (RequestException $e) {
            return null;
        }
    }
}


